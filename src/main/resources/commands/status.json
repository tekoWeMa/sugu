{
  "name": "status",
  "description": "Manage bot presence status",
  "default_member_permissions": "0",
  "options": [
    {
      "name": "rotate",
      "description": "Enable rotating status (default behavior)",
      "type": 1
    },
    {
      "name": "preset",
      "description": "Set a predefined status",
      "type": 1,
      "options": [
        {
          "name": "name",
          "description": "Preset name: stats, activities, users, help, stalking, listening, competing",
          "type": 3,
          "required": true,
          "choices": [
            {"name": "stats - Watching X users • Y games", "value": "stats"},
            {"name": "activities - Watching X activities today", "value": "activities"},
            {"name": "users - Watching over X users", "value": "users"},
            {"name": "servers - Playing in X servers", "value": "servers"},
            {"name": "help - Playing /help", "value": "help"},
            {"name": "listening - Listening to your Spotify", "value": "listening"}
          ]
        }
      ]
    },
    {
      "name": "custom",
      "description": "Set a custom status",
      "type": 1,
      "options": [
        {
          "name": "type",
          "description": "Activity type",
          "type": 3,
          "required": true,
          "choices": [
            {"name": "Playing", "value": "playing"},
            {"name": "Listening to", "value": "listening"},
            {"name": "Watching", "value": "watching"},
            {"name": "Competing in", "value": "competing"}
          ]
        },
        {
          "name": "text",
          "description": "Status text",
          "type": 3,
          "required": true
        }
      ]
    },
    {
      "name": "show",
      "description": "Show current status mode",
      "type": 1
    }
  ]
}
